<%- include('../partials/head') %>
<%- include('../partials/app-nav') %>

<div class="container py-4" style="max-width: 480px;">
  <h2 class="mb-4">Make a Transfer</h2>
  <%- include('../partials/flash') %>
  <form action="/transfer" method="POST">
    <div class="mb-3">
      <label class="form-label">From</label>
      <select name="from_account_type" id="transfer-from-account" class="form-select" required>
        <% accounts.forEach(function(a) { %>
          <option value="<%= a.account_type %>"><%= a.display_label %> — $<%= a.balance.toFixed(2) %></option>
        <% }); %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">To</label>
      <select name="to_account_type" id="transfer-to-account" class="form-select" required>
        <% accounts.forEach(function(a) { %>
          <option value="<%= a.account_type %>"><%= a.display_label %> — $<%= a.balance.toFixed(2) %></option>
        <% }); %>
      </select>
    </div>
    <div class="mb-3">
      <label class="form-label">Amount</label>
      <div class="input-group">
        <span class="input-group-text">$</span>
        <input type="number" step="0.01" min="0.01" name="amount" id="transfer-amount" class="form-control" required>
      </div>
    </div>
    <button type="submit" id="transfer-submit" class="btn btn-primary w-100">Transfer Funds</button>
  </form>
</div>

<%- include('../partials/footer') %>
