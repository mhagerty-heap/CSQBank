<%- include('../partials/head') %>
<%- include('../partials/app-nav') %>

<%
const STATUS_COLORS = {
  draft: 'secondary', submitted: 'info', under_review: 'primary',
  docs_requested: 'warning', docs_submitted: 'primary',
  approved: 'success', denied: 'danger'
};
%>

<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">My Loans</h2>
    <div class="dropdown">
      <button class="btn btn-primary btn-sm dropdown-toggle" id="loan-new-dropdown-toggle" data-bs-toggle="dropdown">Start New Application</button>
      <ul class="dropdown-menu">
        <li><a class="dropdown-item" id="loan-new-personal" href="/loans/new?loan_type=personal">Personal Loan</a></li>
        <li><a class="dropdown-item" id="loan-new-auto" href="/loans/new?loan_type=auto">Auto Loan</a></li>
      </ul>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <div class="table-responsive">
    <table class="table table-hover align-middle bg-white">
      <thead>
        <tr><th>Type</th><th>Amount</th><th>Status</th><th>Updated</th><th></th></tr>
      </thead>
      <tbody>
        <% applications.forEach(function(a) { %>
          <tr>
            <td class="text-capitalize"><%= a.loan_type %></td>
            <td><%= a.requested_amount ? '$' + a.requested_amount.toFixed(2) : '—' %></td>
            <td><span class="badge status-badge bg-<%= STATUS_COLORS[a.status] || 'secondary' %>"><%= a.status.replace('_', ' ') %></span></td>
            <td><%= a.updated_at %></td>
            <td>
              <% if (a.status === 'draft') { %>
                <a href="/loans/<%= a.id %>/edit?step=<%= a.current_step %>" id="loan-continue-<%= a.id %>" class="btn btn-sm btn-outline-primary">Continue</a>
              <% } else { %>
                <a href="/loans/<%= a.id %>" id="loan-view-<%= a.id %>" class="btn btn-sm btn-outline-primary">View</a>
              <% } %>
            </td>
          </tr>
        <% }); %>
        <% if (!applications.length) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">No loan applications yet</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
