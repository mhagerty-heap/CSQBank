<%- include('../partials/head') %>
<%- include('../partials/app-nav') %>

<%
const STATUS_COLORS = {
  submitted: 'info', under_review: 'primary', docs_requested: 'warning',
  docs_submitted: 'primary', approved: 'success', denied: 'danger'
};
%>

<div class="container py-4" style="max-width: 640px;">
  <div class="d-flex justify-content-between align-items-start mb-4">
    <div>
      <h2 class="mb-1 text-capitalize"><%= loan.loan_type %> Loan Application</h2>
      <p class="text-muted mb-0">$<%= loan.requested_amount ? loan.requested_amount.toFixed(2) : '0.00' %> over <%= loan.term_months %> months</p>
    </div>
    <span class="badge status-badge bg-<%= STATUS_COLORS[loan.status] || 'secondary' %> fs-6"><%= loan.status.replace('_', ' ') %></span>
  </div>

  <%- include('../partials/flash') %>

  <% if (loan.status === 'approved') { %>
    <div class="alert alert-success">Congratulations — your loan was approved at <strong><%= loan.apr %>% APR</strong>.</div>
  <% } else if (loan.status === 'denied') { %>
    <div class="alert alert-danger"><%= loan.decision_note %></div>
  <% } %>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <h6 class="mb-3">Application Timeline</h6>
      <ul class="timeline mb-0">
        <% events.forEach(function(e) { %>
          <li>
            <div class="fw-semibold text-capitalize"><%= e.to_status.replace('_', ' ') %></div>
            <div class="text-muted small"><%= e.note %></div>
            <div class="text-muted small"><%= e.created_at %></div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <% if (loan.status === 'docs_requested') { %>
    <div class="card border-0 shadow-sm mb-4">
      <div class="card-body">
        <h6>Documents Requested</h6>
        <p class="text-muted small">Our underwriting team has requested proof of income. In this demo, just confirm you've "submitted" it.</p>
        <form action="/loans/<%= loan.id %>/respond-docs" method="POST">
          <button type="submit" class="btn btn-warning">I've Submitted My Documents</button>
        </form>
      </div>
    </div>
  <% } %>

  <% if (['submitted', 'under_review', 'docs_submitted'].includes(loan.status)) { %>
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6>Demo Control</h6>
        <p class="text-muted small">In production, underwriting updates happen behind the scenes over several days. For this demo, advance the status yourself.</p>
        <form action="/loans/<%= loan.id %>/advance" method="POST">
          <button type="submit" class="btn btn-primary">Advance Underwriting Status</button>
        </form>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
