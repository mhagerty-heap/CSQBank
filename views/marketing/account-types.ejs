<%- include('../partials/head') %>
<%- include('../partials/marketing-nav') %>

<div class="container py-5">
  <h1 class="mb-4 text-center">Account Types</h1>
  <div class="row g-4">
    <div class="col-md-6">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5><i class="bi bi-wallet2 text-primary"></i> Checking</h5>
          <p class="text-muted">Everyday spending with unlimited transactions, deposits, and bill pay.</p>
          <a href="/signup" class="btn btn-outline-primary btn-sm">Open a Checking Account</a>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5><i class="bi bi-piggy-bank text-primary"></i> Savings</h5>
          <p class="text-muted">Grow your balance while keeping funds easily accessible.</p>
          <a href="/signup" class="btn btn-outline-primary btn-sm">Open a Savings Account</a>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5><i class="bi bi-credit-card text-primary"></i> Credit Card</h5>
          <p class="text-muted">Competitive rates and rewards on everyday purchases.</p>
          <a href="/signup" class="btn btn-outline-primary btn-sm">Get Started</a>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <h5><i class="bi bi-cash-coin text-primary"></i> Personal &amp; Auto Loans</h5>
          <p class="text-muted">Apply online and track your application through underwriting, from submission to decision.</p>
          <a href="/signup" class="btn btn-outline-primary btn-sm">Apply for a Loan</a>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
