<%- include('../partials/head') %>
<%- include('../partials/marketing-nav') %>

<div class="container py-5">
  <h1 class="mb-4 text-center">Features</h1>
  <div class="row g-4">
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" id="real-time-balances">
        <div class="card-body">
          <i class="bi bi-graph-up text-primary fs-3"></i>
          <h5 class="mt-3">Real-Time Balances</h5>
          <p class="text-muted small mb-0">See your checking and savings activity update the moment a transaction posts.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" id="transfers-bill-pay">
        <div class="card-body">
          <i class="bi bi-arrow-left-right text-primary fs-3"></i>
          <h5 class="mt-3">Transfers &amp; Bill Pay</h5>
          <p class="text-muted small mb-0">Move money between accounts, pay a biller, or pay a friend in a few clicks.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" id="loan-applications">
        <div class="card-body">
          <i class="bi bi-cash-coin text-primary fs-3"></i>
          <h5 class="mt-3">Loan Applications</h5>
          <p class="text-muted small mb-0">Apply for a personal or auto loan and follow it through underwriting in real time.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <i class="bi bi-credit-card text-primary fs-3"></i>
          <h5 class="mt-3">Credit Card Offers</h5>
          <p class="text-muted small mb-0">Apply for a CSQBank credit card right from your dashboard.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <i class="bi bi-shield-check text-primary fs-3"></i>
          <h5 class="mt-3">Secure by Design</h5>
          <p class="text-muted small mb-0">Your data stays with CSQBank — built with modern web security practices.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm">
        <div class="card-body">
          <i class="bi bi-phone text-primary fs-3"></i>
          <h5 class="mt-3">Anywhere Access</h5>
          <p class="text-muted small mb-0">A responsive experience that works on desktop, tablet, and mobile.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" id="mobile-check-deposit">
        <div class="card-body">
          <i class="bi bi-camera text-primary fs-3"></i>
          <h5 class="mt-3">Mobile Check Deposit</h5>
          <p class="text-muted small mb-0">Snap a photo of your check and the funds are on their way — no branch visit required.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" id="spending-insights">
        <div class="card-body">
          <i class="bi bi-pie-chart text-primary fs-3"></i>
          <h5 class="mt-3">Spending Insights</h5>
          <p class="text-muted small mb-0">See where your money goes with automatic categorization and monthly trends.</p>
        </div>
      </div>
    </div>
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 border-0 shadow-sm" id="real-time-alerts">
        <div class="card-body">
          <i class="bi bi-bell text-primary fs-3"></i>
          <h5 class="mt-3">Real-Time Alerts</h5>
          <p class="text-muted small mb-0">Get notified instantly on deposits, low balances, and unusual account activity.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
