<section class="hero">
  <div class="container text-center">
    <h1 class="display-5 mb-3">Banking that keeps up with you</h1>
    <p class="lead mb-4">Checking, savings, transfers, bill pay, and loans — all in one place.</p>
    <a href="/signup" id="home-hero-signup-cta" class="btn btn-cta btn-lg px-4">Open an Account</a>
  </div>
</section>

<div class="container py-5">
  <div class="row g-4 text-center">
    <div class="col-md-4">
      <i class="bi bi-bank fs-1 text-primary"></i>
      <h5 class="mt-3">Checking &amp; Savings</h5>
      <p class="text-muted small">Real-time balances and activity across both accounts.</p>
    </div>
    <div class="col-md-4">
      <i class="bi bi-arrow-left-right fs-1 text-primary"></i>
      <h5 class="mt-3">Instant Transfers</h5>
      <p class="text-muted small">Move money between your accounts or pay a friend in seconds.</p>
    </div>
    <div class="col-md-4">
