      <div class="col-md-4 text-center">
        <div class="phone-mockup">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-statusbar">
              <span>9:41</span>
              <span><i class="bi bi-reception-4"></i> <i class="bi bi-wifi"></i> <i class="bi bi-battery-full"></i></span>
            </div>
            <div class="phone-app-header">Deposit Check</div>
            <div class="phone-app-body">
              <div class="check-capture-frame">
                <i class="bi bi-camera fs-3"></i>
              </div>
              <div class="phone-fake-btn">Capture Front</div>
            </div>
          </div>
        </div>
        <h4 class="mt-4">Mobile check deposit</h4>
        <p class="text-muted">Snap a photo of your check and the funds are on their way — no branch visit required.</p>
      </div>
      <div class="col-md-4 text-center">
        <div class="phone-mockup">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-statusbar">
              <span>9:41</span>
              <span><i class="bi bi-reception-4"></i> <i class="bi bi-wifi"></i> <i class="bi bi-battery-full"></i></span>
            </div>
            <div class="phone-app-header">This Month</div>
            <div class="phone-app-body">
              <div class="spending-donut"></div>
              <div class="spending-row"><span class="dot dot-teal"></span> Groceries <span class="spending-bar" style="width:70%"></span></div>
              <div class="spending-row"><span class="dot dot-navy"></span> Bills <span class="spending-bar" style="width:50%"></span></div>
              <div class="spending-row"><span class="dot dot-gray"></span> Dining <span class="spending-bar" style="width:35%"></span></div>
            </div>
          </div>
        </div>
        <h4 class="mt-4">Spending insights</h4>
        <p class="text-muted">See where your money goes with automatic categorization and monthly trends.</p>
      </div>
      <div class="col-md-4 text-center">
        <div class="phone-mockup">
          <div class="phone-notch"></div>
          <div class="phone-screen">
            <div class="phone-statusbar">
              <span>9:41</span>
              <span><i class="bi bi-reception-4"></i> <i class="bi bi-wifi"></i> <i class="bi bi-battery-full"></i></span>
            </div>
            <div class="phone-app-header">Notifications</div>
            <div class="phone-app-body">
              <div class="alert-card"><i class="bi bi-arrow-down-circle-fill text-success"></i><div><div class="alert-title">Deposit received</div><div class="alert-sub">$1,200.00</div></div></div>
              <div class="alert-card"><i class="bi bi-exclamation-triangle-fill text-warning"></i><div><div class="alert-title">Low balance</div><div class="alert-sub">Checking below $100</div></div></div>
              <div class="alert-card"><i class="bi bi-shield-fill-check text-primary"></i><div><div class="alert-title">New sign-in</div><div class="alert-sub">Recognized device</div></div></div>
            </div>
          </div>
        </div>
        <h4 class="mt-4">Real-time alerts</h4>
        <p class="text-muted">Get notified instantly on deposits, low balances, and unusual account activity.</p>
      </div>
    </div>
  </div>
</section>

