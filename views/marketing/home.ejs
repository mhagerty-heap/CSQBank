      <div class="col-md-4">
        <i class="bi bi-star-fill fs-2 text-primary"></i>
        <p class="small text-muted mb-0 mt-2">4.8/5 average app store rating</p>
      </div>
    </div>
  </div>
</section>

<section class="savings-offer">
  <div class="container text-center">
    <span class="badge rounded-pill savings-offer-badge mb-3">Limited-Time Offer</span>
