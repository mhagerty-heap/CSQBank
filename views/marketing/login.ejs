<%- include('../partials/head') %>
<%- include('../partials/marketing-nav') %>

<div class="container py-5" style="max-width: 420px;">
  <h1 class="mb-2 text-center">Log In</h1>
  <p class="text-muted text-center small mb-4">Enter any email to access the demo — no account setup required.</p>
  <%- include('../partials/flash') %>
  <form action="/login" method="POST">
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Password</label>
      <input type="password" name="password" class="form-control" placeholder="Any password works">
    </div>
    <button type="submit" class="btn btn-primary w-100">Log In</button>
  </form>
  <p class="text-center small mt-3 mb-0">New here? <a href="/signup">Open an account</a></p>
</div>

<%- include('../partials/footer') %>
