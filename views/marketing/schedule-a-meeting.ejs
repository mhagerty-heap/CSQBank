<%- include('../partials/head') %>
<%- include('../partials/marketing-nav') %>

<div class="container py-5" style="max-width: 640px;">
  <h1 class="mb-4">Schedule a Meeting</h1>
  <p class="text-muted">Talk to a CSQBank representative about checking, savings, or loan products.</p>
  <%- include('../partials/flash') %>
  <form action="/schedule-a-meeting" method="POST">
    <div class="mb-3">
      <label class="form-label">Name</label>
      <input type="text" name="name" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Email</label>
      <input type="email" name="email" class="form-control" required>
    </div>
    <div class="mb-3">
      <label class="form-label">Preferred Date</label>
      <input type="date" name="preferred_date" class="form-control">
    </div>
    <div class="mb-3">
      <label class="form-label">What would you like to discuss?</label>
      <textarea name="topic" class="form-control" rows="3"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Request a Meeting</button>
  </form>
</div>

<%- include('../partials/footer') %>
