<%- include('../partials/head') %>
<%- include('../partials/app-nav') %>

<div class="container py-4" style="max-width: 480px;">
  <h2 class="mb-4"><%= accountLabel %> Pay Bill</h2>
  <%- include('../partials/flash') %>
  <form action="/<%= accountType %>/pay-bill" method="POST">
    <div class="mb-3">
      <label class="form-label">Payee</label>
      <select name="payee_code" id="pay-bill-payee-select" class="form-select" required>
        <option value="" disabled selected>Choose a payee</option>
        <% payees.forEach(function(p) { %>
          <option value="<%= p.code %>"><%= p.name %></option>
        <% }); %>
      </select>
      <div class="form-text">Don't see your payee? <a href="/bill-pay/payees/new" id="pay-bill-add-payee-link">Add one</a>.</div>
    </div>
    <div class="mb-3">
      <label class="form-label">Amount</label>
      <div class="input-group">
        <span class="input-group-text">$</span>
        <input type="number" step="0.01" min="0.01" name="amount" id="pay-bill-amount" class="form-control" required>
      </div>
    </div>
    <div class="mb-3">
      <label class="form-label">Pay Date</label>
      <input type="date" name="pay_date" id="pay-bill-pay-date" class="form-control">
    </div>
    <div class="mb-3">
      <label class="form-label">Note (optional)</label>
      <input type="text" name="notes" id="pay-bill-notes" class="form-control">
    </div>
    <button type="submit" id="pay-bill-submit" class="btn btn-primary w-100">Pay Bill</button>
  </form>
</div>

<%- include('../partials/footer') %>
