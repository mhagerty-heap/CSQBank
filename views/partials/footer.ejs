<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function() {
  // Fires identify() on any form submission carrying an email address —
  // covers the shared login/signup form, contact form, etc. Fires
  // regardless of success/failure, matching the "fire on intent" pattern.
  document.addEventListener('submit', function(e) {
    var emailInput = e.target.querySelector('input[type="email"]');
    var email = emailInput ? emailInput.value.trim() : '';
    if (!email) return;
    window._uxa = window._uxa || [];
    window._uxa.push(['identify', email]);
    console.log('CS identify fired for email: ' + email);
  });
})();

<% if (typeof pendingTrackEvent !== 'undefined' && pendingTrackEvent) { %>
(function() {
  var eventName = <%- JSON.stringify(pendingTrackEvent.name) %>;
  var eventProps = <%- JSON.stringify(pendingTrackEvent.properties) %>;
  window._uxa = window._uxa || [];
  window._uxa.push(["afterPageView", function(context) {
    if (context.pageViewType !== "n") return;
    window._uxa.push(["trackEvent", { name: eventName, properties: eventProps }]);
    console.log('CSQBank tracking: ' + eventName + ' fired (via _uxa)', eventProps);
  }]);
})();
<% } %>
</script>
</body>
</html>
